        },
        "doseAmount": {
          "$ref": "#/$defs/SimpleAttribute"
        },
        "doseAmountUnit": {
          "$ref": "#/$defs/CodeableConcept"
        },
        "doseRoute": {
          "$ref": "#/$defs/CodeableConcept"
        },
        "doseQuantity": {
          "$ref": "#/$defs/SimpleAttribute"
        },
        "doseQuantityUnit": {
          "$ref": "#/$defs/SimpleAttribute"
        },
        "instructions": {
          "$ref": "#/$defs/SimpleAttribute"
        },
        "adherence": {
          "$ref": "#/$defs/CodeableConcept"
        },
        "indication": {
          "$ref": "#/$defs/CodeableConcept"
        },
        "fillStatus": {
          "$ref": "#/$defs/CodeableConcept"
        }
      },
      "additionalProperties": false
    },
    "Practitioner": {
      "type": "object",
      "properties": {
        "practitionerName": {
